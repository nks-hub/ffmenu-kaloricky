{
  "manifest_version": 3,
  "name": "FF Menu do Kalorických tabulek",
  "version": "3.0.0",
  "description": "Na jídelníčku ffmenu.cz ukáže na kliknutí QR kód, který jídlo otevře v aplikaci Kalorické tabulky, a doplní kcal k energii v kJ. Bez přihlašování.",
  "host_permissions": [
    "https://ffkt.nks-hub.cz/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ffmenu.cz/jidelnicek*",
        "https://ffmenu.cz/jidelnicek*"
      ],
      "js": [
        "lib/qrcode.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ffmenu-kt@local",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
